generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Professional {
  id           String  @id @default(cuid())
  name         String
  email        String  @unique
  phone        String?
  passwordHash String?
  timezone     String  @default("America/Santiago")
  // Data URL (data:image/...;base64,...) de la foto de perfil. Se guarda en la fila en vez de
  // en un archivo/bucket porque el filesystem del proceso no es persistente entre deploys.
  photoUrl     String?

  bookingWindowWeeks     Int    @default(4)
  minAdvanceBusinessDays Int    @default(2)
  minAdvanceUnit         String @default("business_days")
  defaultBufferMinutes   Int    @default(0)

  patientSearchField String   @default("name")
  treatmentTypes     String[] @default([])

  dailyDigestTime         String  @default("16:00")
  lastDailyDigestSentDate String?

  transferRut           String?
  transferBank          String?
  transferAccountType   String?
  transferAccountNumber String?
  transferEmail         String?

  cashPaymentEnabled Boolean @default(true)

  services         Service[]
  weeklySchedules  WeeklySchedule[]
  scheduleBlocks   ScheduleBlock[]
  appointments     Appointment[]
  consentDocuments ConsentDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Service {
  id             String  @id @default(cuid())
  professionalId String
  name           String
  description    String
  duration       Int
  price          Int
  modality       String
  bufferMinutes  Int?
  isActive       Boolean @default(true)

  professional Professional @relation(fields: [professionalId], references: [id])
  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WeeklySchedule {
  id             String   @id @default(cuid())
  professionalId String
  dayOfWeek      Int
  startTime      String
  endTime        String
  serviceIds     String[]
  isActive       Boolean  @default(true)

  professional Professional @relation(fields: [professionalId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ScheduleBlock {
  id             String    @id @default(cuid())
  professionalId String
  title          String
  startDateTime  DateTime
  endDateTime    DateTime
  recurrenceType String?
  recurrenceEnd  DateTime?

  professional Professional @relation(fields: [professionalId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Appointment {
  id             String @id @default(cuid())
  professionalId String
  serviceId      String

  clientName  String
  clientEmail String
  clientPhone String

  startDateTime DateTime
  endDateTime   DateTime
  modality      String
  status        String   @default("pending")

  googleEventId String?
  meetLink      String?

  paymentStatus  String  @default("unpaid")
  paymentAmount  Int?
  paymentMethod  String?

  bookingFlow      String    @default("advance")
  paymentDeadline  DateTime?
  autoCancelledAt  DateTime?

  // Registro de citas canceladas (US-088): cuándo, quién (patient | admin | rescheduled) y, si se
  // reagendó, el id de la cita nueva.
  cancelledAt      DateTime?
  cancellationType String?
  rescheduledToId  String?

  outcome String?

  attended Boolean?

  attendanceConfirmed   Boolean   @default(false)
  attendanceConfirmedAt DateTime?

  notes String?

  reminderSentAt        DateTime?
  reminder2hSentAt      DateTime?
  paymentReminderSentAt DateTime?

  appointmentToken String?   @unique
  tokenExpiresAt   DateTime?

  // Enlace para dejar una reseña de ESTA sesión (US-072). Se genera cuando se pide la reseña
  // (panel o correo post-sesión); no vence, pero solo sirve una vez.
  reviewToken String? @unique

  // Encuesta post-sesión (US-099/100): la paciente la aceptó al agendar (check marcado por
  // defecto) y cuándo se envió. Se envía cuando Stefany marca la sesión como "Asistió".
  surveyOptIn  Boolean   @default(false)
  surveySentAt DateTime?

  professional Professional @relation(fields: [professionalId], references: [id])
  service      Service      @relation(fields: [serviceId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Documentos legales/editoriales del flujo de agendamiento, editables desde el panel admin.
// `type` distingue entre los distintos documentos (hoy: almacenamiento de datos y cancelación) —
// mismo shape y misma lógica de saneamiento para ambos, por eso comparten tabla en vez de duplicarla.
model ConsentDocument {
  id             String @id @default(cuid())
  professionalId String
  type           String @default("data_storage")
  title          String
  content        String

  updatedById String?

  professional Professional @relation(fields: [professionalId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([professionalId, type])
}

model Client {
  id               String  @id @default(cuid())
  email            String  @unique
  name             String
  phone            String?
  rut              String?
  passwordHash     String?
  isVerified       Boolean @default(false)
  treatmentType    String?
  dataConsentGiven Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Reseñas de pacientes (US-072/073/097). Las del sitio quedan ligadas a la sesión evaluada y a la
// paciente (trazabilidad); las importadas (Agify, Google) solo traen su id externo.
model Review {
  id             String   @id @default(cuid())
  professionalId String
  // web | agify | google
  source         String   @default("web")
  externalId     String?
  appointmentId  String?  @unique
  clientId       String?
  rating         Int
  comment        String?
  isAnonymous    Boolean  @default(false)
  // Nombre que se muestra (lo escribe la paciente; en importadas, iniciales). Null si es anónima.
  displayName    String?
  // El nombre escrito no coincide con el de la paciente: Stefany debe verificarlo antes de aprobar.
  nameMismatch   Boolean  @default(false)
  // pending | approved | rejected
  status         String   @default("pending")
  moderatedAt    DateTime?
  publicReply    String?
  repliedAt      DateTime?
  serviceName    String?
  // Fecha de la reseña (en importadas, la original de la plataforma).
  reviewedAt     DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([source, externalId])
  @@index([professionalId, status, reviewedAt])
}

// Pacientes que pidieron no recibir más encuestas (enlace del correo, US-100). Por email: no
// depende de que exista una ficha de paciente.
model SurveyOptOut {
  email     String   @id
  createdAt DateTime @default(now())
}

// Historial de cambios para auditoría: cada creación, modificación o eliminación de datos y eventos
// clave (login de la admin, correos). Se escribe solo desde lib/audit.ts; se conserva 2 años.
model AuditLog {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  professionalId String?
  // admin | patient | system | anonymous
  actorType      String
  actorId        String?
  // create | update | delete | upsert | <evento> (ej. rescheduled, login_failed, email_sent)
  action         String
  entity         String
  entityId       String?
  // update: { campo: { from, to } } · create/delete: snapshot · eventos: datos del evento
  changes        Json?
  source         String?
  ip             String?
  userAgent      String?

  @@index([entity, entityId])
  @@index([createdAt])
}
