DATABASE_URL="postgresql://[user]:[password]@[host]:[port]/[database]"
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=noreply@your-domain.com
RESEND_FROM_NAME=Your Name
PROFESSIONAL_ADDRESS=Address shown in presential appointment emails
API_BASE_URL=Public base URL of this API, used for links in emails (e.g. https://api.your-domain.com)
ADMIN_URL=Public base URL of the admin frontend, used for the "Ver agenda completa" link in the daily digest (e.g. https://admin.your-domain.com)
