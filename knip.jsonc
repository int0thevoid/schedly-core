{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  // Binarios provistos por el entorno (runner de deploy / CI), no por dependencias del paquete
  "ignoreBinaries": ["prisma", "pm2", "eslint"],
  // Lo usa el cliente Prisma generado en packages/booking/src/generated
  "ignoreDependencies": ["@prisma/client"]
}
